PORT=5002
NODE_ENV=development
# PostgreSQL : base « sigrh » (créée dans pgAdmin ou avec createdb)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sigrh
DB_SSL=false
DB_POOL_MAX=10
# Base de test (npm test) — elle est vidée à chaque exécution
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sigrh_test
# Au moins 32 caractères aléatoires en production
JWT_SECRET=change_me_to_a_long_random_secret_value
JWT_EXPIRES_IN=8h
# Origines autorisées pour le front-end (séparées par des virgules)
CLIENT_URL=http://localhost:5173
TZ=Africa/Dakar

# --- Sécurité (section 14 du cahier des charges)
# Double authentification obligatoire pour les profils DRH, pilotage et DSI (mettre false pour une démonstration)
MFA_REQUIRED=true
# Clé de chiffrement AES-256 des données sensibles (NIN, secrets 2FA) : 32 octets encodés en base64.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obligatoire en production ; en développement, elle est dérivée de JWT_SECRET si absente.
# ⚠ Ne jamais la changer après la mise en service : les données déjà chiffrées deviendraient illisibles.
DATA_ENCRYPTION_KEY=
# Tentatives de connexion échouées autorisées par 15 minutes et par IP (les connexions réussies ne comptent pas)
AUTH_RATE_LIMIT=20
# Périodicité de la revue des habilitations (jours)
RIGHTS_REVIEW_DAYS=180

# --- Règles de gestion
RETIREMENT_AGE=60
# Écart toléré entre le salaire du référentiel et le montant payé par la Solde (0.05 = 5 %)
SOLDE_GAP_TOLERANCE=0.05
WORK_START=08:00
LATE_GRACE_MINUTES=15
WORK_HOURS_PER_DAY=8
# Simulation de bulletin (le montant officiel reste celui de la Solde)
PAY_HOUSING_RATE=0.15
PAY_TRANSPORT=25000
PAY_SOCIAL_RATE=0.056
PAY_OVERTIME_MULT=1.25

# --- Interconnexions
# Service de vérification de l'état civil (laisser vide = mode simulation)
ETAT_CIVIL_URL=
ETAT_CIVIL_TOKEN=
